local function fn7(arg)
	for i = 1, 4 do
		local ok, result = pcall(function()
			return request({ Url = arg, Method = "GET", Headers = { ["User-Agent"] = "Mozilla/5.0" } })
		end)
		if not ok or not result then
			return nil
		end
		if result.StatusCode == 301 or result.StatusCode == 302 or result.StatusCode == 307 or result.StatusCode == 308 then
			local headers = result.Headers or {}
			local location = headers.Location or headers.location or headers.Location or headers.location
			if not location or location == arg then
				return nil
			end
			arg = location:gsub("^http://", "https://")
			continue
		end
		return result.Body
	end
	return nil
end

local function fn8(arg)
