-- ========== 粒子模块 ==========
local particleEmitter
local function createParticle()
	local char = speaker.Character
	if not char then return end
	local root = char:WaitForChild("HumanoidRootPart")
	if particleEmitter then particleEmitter:Destroy() end
	particleEmitter = Instance.new("ParticleEmitter")
	particleEmitter.Parent = root
	particleEmitter.Color = ColorSequence.new(Color3.fromRGB(160,0,255))
	particleEmitter.Size = NumberSequence.new(0.25)
	particleEmitter.Lifetime = NumberRange.new(0.4,0.7)
	particleEmitter.Rate = 0
	particleEmitter.Speed = NumberRange.new(4,7)
	particleEmitter.SpreadAngle = Vector2.new(20,20)
end
createParticle()
speaker.CharacterAdded:Connect(createParticle)

task.spawn(function()
	while task.wait(0.08) do
		if particleEnabled and particleEmitter then
			particleEmitter:Emit(8)
		end
	end
end)

particleToggle.MouseButton1Down:Connect(function()
	particleEnabled = not particleEnabled
	particleToggle.Text = particleEnabled and "粒子:开" or "粒子:关"
end)
