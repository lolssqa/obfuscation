local animTracks = {}
local loopedTrack = nil
local playbackSpeed = 1
local selectedAnim = animList[1]
local animNameList = {}
for _,a in ipairs(animList) do
	table.insert(animNameList, a.Name)
end
local function playAnim(animItem, looped)
	local plr = game.Players.LocalPlayer
	local char = plr.Character
	if not char then return lib:Notify({Title="提示",Content="角色不存在",Duration=3}) end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return lib:Notify({Title="提示",Content="找不到Humanoid",Duration=3}) end
	local animObj = Instance.new("Animation")
	animObj.AnimationId = animItem.Id
	local track = hum:LoadAnimation(animObj)
	if not track then return end
	track:Play()
	pcall(function() track.PlaybackSpeed = playbackSpeed end)
	track.Looped = looped
	table.insert(animTracks, {track=track,name=animItem.Name})
	track.Ended:Connect(function()
		for i=#animTracks,1,-1 do
			if animTracks[i].track == track then
				table.remove(animTracks,i)
				break
			end
		end
	end)
end
