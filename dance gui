local selectedAnimPack = "Default"
local animPackEnabled = false
local originalAnimData = nil
local animPackNameList = {}
for k in pairs(animPacks) do
	table.insert(animPackNameList,k)
end
local function applyAnimPack(packName)
	local char = game.Players.LocalPlayer.Character
	if not char then return end
	local animate = char:FindFirstChild("Animate")
	if not animate then return end
	local pack = animPacks[packName]
	if not pack then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		local animator = hum:FindFirstChildOfClass("Animator")
		if animator then
			for _,track in ipairs(animator:GetPlayingAnimationTracks()) do
				track:Stop()
			end
		end
	end
	local idleObj = animate:FindFirstChild("idle")
	if idleObj and pack.idle then
		idleObj:ClearAllChildren()
		for i,idStr in ipairs(pack.idle) do
			local a = Instance.new("Animation")
			a.Name = "Animation"..i
			a.AnimationId = "rbxassetid://"..idStr
			a.Parent = idleObj
		end
	end
	for _,animKey in ipairs({"walk","run","jump","fall","climb","swim","swimidle"}) do
		local childObj = animate:FindFirstChild(animKey)
		local assetId = pack[animKey]
		if childObj and assetId then
			childObj:ClearAllChildren()
			local a = Instance.new("Animation")
			a.AnimationId = "rbxassetid://"..assetId
			a.Parent = childObj
		end
	end
	animate.Disabled = true
	task.wait()
	animate.Disabled = false
end
local function saveOriginalAnimate()
	local char = game.Players.LocalPlayer.Character
	if not char then return end
	local animate = char:FindFirstChild("Animate")
	if not animate then return end
	originalAnimData = {}
	for _,animKey in ipairs({"idle","walk","run","jump","fall","climb","swim","swimidle"}) do
		local childObj = animate:FindFirstChild(animKey)
		if childObj then
			local list = {}
			for _,a in ipairs(childObj:GetChildren()) do
				if a:IsA("Animation") then
					table.insert(list, {name=a.Name,id=a.AnimationId})
				end
			end
			originalAnimData[animKey] = list
		end
	end
end
local function restoreOriginalAnimate()
	if not originalAnimData then return end
	local char = game.Players.LocalPlayer.Character
	if not char then return end
	local animate = char:FindFirstChild("Animate")
	if not animate then return end
	for animKey,list in pairs(originalAnimData) do
		local childObj = animate:FindFirstChild(animKey)
		if childObj then
			childObj:ClearAllChildren()
			for _,item in ipairs(list) do
				local a = Instance.new("Animation")
				a.Name = item.name
				a.AnimationId = item.id
				a.Parent = childObj
			end
		end
	end
	animate.Disabled = true
	task.wait()
	animate.Disabled = false
end
