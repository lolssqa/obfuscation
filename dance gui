tbl.Animation:AddToggle("AnimLoop",{
	Title="循环播放",
	Default=false,
	Callback=function(val)
		if val then
			if loopedTrack then pcall(function() loopedTrack:Stop() end) end
			local char = game.Players.LocalPlayer.Character
			if not char then lib:Notify({Title="提示",Content="角色不存在",Duration=3}) return end
			local hum = char:FindFirstChildOfClass("Humanoid")
			if not hum then return end
			local animObj = Instance.new("Animation")
			animObj.AnimationId = selectedAnim.Id
			loopedTrack = hum:LoadAnimation(animObj)
			loopedTrack.Looped = true
			loopedTrack.PlaybackSpeed = playbackSpeed
			loopedTrack:Play()
		else
			if loopedTrack then
				pcall(function() loopedTrack:Stop() end)
				loopedTrack = nil
			end
		end
	end
})
