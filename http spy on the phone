local function isLua(fn)
    local ok, info = pcall(debug.getinfo, fn, "S")
    return ok and info and info.what == "Lua"
end

local SIGNS = {
    "Log copied to clipboard!", "HTTP GET", "HTTP POST", "createLogEntry",
    "Your exploit is not supported!", "HTTP Spy made by", "httplogs.txt",
    "HookSynRequest", "BlockUrl", "ProxyHost", "__namecall",
    "HttpSpyLogger", "Http Spy",
}

local function checkHttp()
    if isLua(game.HttpGet)  then return true, "HttpGet 被 Hook"  end
    if isLua(game.HttpPost) then return true, "HttpPost 被 Hook" end
    return false
end

local function checkGui()
    local function scan(parent, tag)
        for _, v in ipairs(parent:GetChildren()) do
            if v:IsA("ScreenGui") then
                local n = v.Name:lower()
                if n:find("httpspy", 1, true)
                    or n:find("http_spy", 1, true)
                    or n:find("simplespy", 1, true) then
                    return true, tag .. ":" .. v.Name
                end
            end
        end
        return false
    end
    local hit, sig = scan(game.CoreGui, "CoreGui")
    if hit then return true, sig end
    if gethui then
        local hui = gethui()
        if hui then
            local h2, s2 = scan(hui, "HUI")
            if h2 then return true, s2 end
        end
    end
    return false
end

local function checkGc()
    if not getgc then return false end
    local ok, gc = pcall(getgc, true)
    if not ok or type(gc) ~= "table" then return false end
    local cap = math.min(#gc, 50)
    for i = 1, cap do
        local v = gc[i]
        if type(v) == "function" then
            local found = false
            pcall(function()
                local ok2, consts = pcall(debug.getconstants, v)
                if ok2 and consts then
                    for _, c in ipairs(consts) do
                        local s = tostring(c)
                        for _, sig in ipairs(SIGNS) do
                            if s:find(sig, 1, true) then
                                found = true
                                break
                            end
                        end
                        if found then break end
                    end
                end
            end)
            if found then return true, "GC 特征匹配" end
        end
    end
    return false
end

