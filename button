local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function ShowNotify(msg)
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "DynamicIsland_ClickNotify"
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.Parent = PlayerGui

    local Island = Instance.new("Frame")
    Island.BackgroundColor3 = Color3.new(0,0,0)
    Island.AnchorPoint = Vector2.new(0.5,0.5)
    Island.Size = UDim2.new(0,32,0,32)
    Island.Position = UDim2.new(0.5,0,0,48)
    Island.BorderSizePixel = 0
    Island.Parent = ScreenGui
    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0,16)
    UICorner.Parent = Island

    local YellowDot = Instance.new("Frame")
    YellowDot.BackgroundColor3 = Color3.fromRGB(255,204,0)
    YellowDot.AnchorPoint = Vector2.new(0,0.5)
    YellowDot.Size = UDim2.new(0,12,0,12)
    YellowDot.Position = UDim2.new(0,12,0.5,0)
    YellowDot.BorderSizePixel = 0
    YellowDot.Visible = false
    YellowDot.Parent = Island
    local DotCorner = Instance.new("UICorner")
    DotCorner.CornerRadius = UDim.new(1,0)
    DotCorner.Parent = YellowDot

    local TextLabel = Instance.new("TextLabel")
    TextLabel.BackgroundTransparency = 1
    TextLabel.AnchorPoint = Vector2.new(0,0.5)
    TextLabel.Position = UDim2.new(0,30,0.5,0)
    TextLabel.Size = UDim2.new(1,-40,0,22)
    TextLabel.Font = Enum.Font.GothamBold
    TextLabel.TextSize = 17
    TextLabel.TextColor3 = Color3.new(1,1,1)
    TextLabel.TextTransparency = 1
    TextLabel.TextXAlignment = Enum.TextXAlignment.Left
    TextLabel.Text = msg
    TextLabel.Parent = Island

    local TweenDotExpand = TweenInfo.new(0.4, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
    local TweenTextFade = TweenInfo.new(0.3, Enum.EasingStyle.Linear)
    local TweenShrink = TweenInfo.new(0.35, Enum.EasingStyle.Cubic, Enum.EasingDirection.In)
    local TweenBreathe = TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, math.huge, true)

    local BreatheTween = TweenService:Create(YellowDot, TweenBreathe, {BackgroundTransparency = 0.4})
    BreatheTween:Play()

    local ExpandTween = TweenService:Create(Island, TweenDotExpand, {Size = UDim2.new(0, 260, 0, 34)})
    ExpandTween:Play()
    task.wait(0.4)
    YellowDot.Visible = true

    local FadeIn1 = TweenService:Create(TextLabel, TweenTextFade, {TextTransparency = 0})
    FadeIn1:Play()
    task.wait(0.3)
    task.wait(1.4)

    local FadeOut1 = TweenService:Create(TextLabel, TweenTextFade, {TextTransparency = 1})
    FadeOut1:Play()
    task.wait(0.3)
    YellowDot.Visible = false

    local ShrinkTween = TweenService:Create(Island, TweenShrink, {Size = UDim2.new(0,32,0,32)})
    ShrinkTween:Play()
    task.wait(0.35)
    ScreenGui:Destroy()
end

ShowNotify("你点击了一个按钮")
